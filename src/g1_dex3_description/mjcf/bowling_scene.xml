<mujoco model="g1_29dof_dex3 bowling">
  <!--
    Layout (metres, world frame, z up). Cricket dimensions from the Laws of Cricket.

      G1 starts at the origin facing +x.
      Table + tray + ball in front of it (front edge x = 0.7, clear of the
      forward-pointing forearms of the G1 zero pose): step up and pick the ball.
      Run-up and pitch run along +y:
        y =  6.00   bowler's-end stumps (fixed)
        y =  7.22   bowler's popping crease: release the ball before this line
        y = 26.12   batter's-end stumps (target, free to be knocked over)
      Pitch strip: 3.05 m wide, centred on x = 0.6 so a run-up along x ~ 0
      passes clear of the bowler's stumps.
  -->
  <include file="g1_29dof_dex3.xml"/>

  <option timestep="0.002"/>

  <statistic center="0.6 3 0.8" extent="4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-150" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="grass" builtin="checker" mark="edge" rgb1="0.20 0.42 0.20"
      rgb2="0.18 0.38 0.18" markrgb="0.25 0.5 0.25" width="300" height="300"/>
    <material name="grass" texture="grass" texuniform="true" texrepeat="2 2" reflectance="0.05"/>
    <material name="pitch" rgba="0.76 0.66 0.45 1"/>
    <material name="crease" rgba="0.95 0.95 0.95 1"/>
    <material name="wood" rgba="0.55 0.38 0.22 1"/>
    <material name="tray" rgba="0.25 0.25 0.30 1"/>
    <material name="stump" rgba="0.93 0.88 0.75 1"/>
    <material name="ball" rgba="0.70 0.05 0.05 1"/>
  </asset>

  <default>
    <default class="visual_only">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
    <default class="stump">
      <geom type="cylinder" size="0.0175 0.3555" material="stump" friction="0.6 0.005 0.0001"/>
    </default>
    <default class="bail">
      <geom type="capsule" size="0.006 0.045" material="stump"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" directional="true"/>
    <light pos="0.6 26 6" dir="0 0 -1" directional="true" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grass"/>

    <!-- Pitch strip and crease markings (visual only, 1 mm above the grass). -->
    <body name="pitch" pos="0.6 16.06 0">
      <geom name="pitch_strip" class="visual_only" type="box" size="1.525 11 0.001" pos="0 0 0.001" material="pitch"/>
      <geom name="bowling_crease_near" class="visual_only" type="box" size="1.32 0.025 0.0012" pos="0 -10.06 0.001" material="crease"/>
      <geom name="popping_crease_near" class="visual_only" type="box" size="1.525 0.025 0.0012" pos="0 -8.84 0.001" material="crease"/>
      <geom name="bowling_crease_far" class="visual_only" type="box" size="1.32 0.025 0.0012" pos="0 10.06 0.001" material="crease"/>
      <geom name="popping_crease_far" class="visual_only" type="box" size="1.525 0.025 0.0012" pos="0 8.84 0.001" material="crease"/>
    </body>
    <site name="release_line" pos="0.6 7.22 0.01" size="0.02" rgba="1 1 0 1"/>

    <!-- Table with a tray; the ball rests in the tray. -->
    <body name="table" pos="0.95 0 0">
      <geom name="table_top" type="box" size="0.25 0.4 0.02" pos="0 0 0.73" material="wood"/>
      <geom type="box" size="0.02 0.02 0.355" pos=" 0.21  0.36 0.355" material="wood"/>
      <geom type="box" size="0.02 0.02 0.355" pos=" 0.21 -0.36 0.355" material="wood"/>
      <geom type="box" size="0.02 0.02 0.355" pos="-0.21  0.36 0.355" material="wood"/>
      <geom type="box" size="0.02 0.02 0.355" pos="-0.21 -0.36 0.355" material="wood"/>
      <body name="tray" pos="-0.1 0 0.75">
        <geom name="tray_base" type="box" size="0.1 0.1 0.005" pos="0 0 0.005" material="tray"/>
        <geom type="box" size="0.1 0.005 0.015" pos="0  0.095 0.025" material="tray"/>
        <geom type="box" size="0.1 0.005 0.015" pos="0 -0.095 0.025" material="tray"/>
        <geom type="box" size="0.005 0.1 0.015" pos=" 0.095 0 0.025" material="tray"/>
        <geom type="box" size="0.005 0.1 0.015" pos="-0.095 0 0.025" material="tray"/>
        <site name="tray_center" pos="0 0 0.01" size="0.005" rgba="0 1 0 1"/>
      </body>
    </body>

    <!-- Cricket ball: 72 mm diameter, 156 g. condim 6 adds rolling friction. -->
    <body name="ball" pos="0.85 0 0.797">
      <freejoint name="ball_joint"/>
      <geom name="ball" type="sphere" size="0.036" mass="0.156" material="ball"
        condim="6" friction="0.8 0.005 0.0005"/>
    </body>

    <!-- Bowler's-end stumps: fixed. Wicket is 0.2286 m wide, stumps 0.711 m tall. -->
    <body name="stumps_near" pos="0.6 6.0 0">
      <geom class="stump" pos="-0.0968 0 0.3555"/>
      <geom class="stump" pos=" 0      0 0.3555"/>
      <geom class="stump" pos=" 0.0968 0 0.3555"/>
    </body>

    <!-- Batter's-end stumps: the target. Free bodies so a hit knocks them down. -->
    <body name="stump_far_off" pos="0.5032 26.12 0.3555">
      <freejoint/>
      <geom name="stump_far_off" class="stump" mass="0.3"/>
    </body>
    <body name="stump_far_middle" pos="0.6 26.12 0.3555">
      <freejoint/>
      <geom name="stump_far_middle" class="stump" mass="0.3"/>
    </body>
    <body name="stump_far_leg" pos="0.6968 26.12 0.3555">
      <freejoint/>
      <geom name="stump_far_leg" class="stump" mass="0.3"/>
    </body>
    <body name="bail_far_1" pos="0.5516 26.12 0.7175" euler="0 1.5708 0">
      <freejoint/>
      <geom name="bail_far_1" class="bail" mass="0.01"/>
    </body>
    <body name="bail_far_2" pos="0.6484 26.12 0.7175" euler="0 1.5708 0">
      <freejoint/>
      <geom name="bail_far_2" class="bail" mass="0.01"/>
    </body>
    <site name="target" pos="0.6 26.12 0.5" size="0.02" rgba="1 0 0 1"/>
  </worldbody>
</mujoco>
